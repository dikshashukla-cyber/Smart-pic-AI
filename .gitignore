*.py[cod]
*$py.class
*.so

# Testing, caching, and coverage artifacts
.pytest_cache/
.hypothesis/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Joblib / Pickle serialized model & preprocessor artifacts
artifacts/*.joblib
artifacts/*.pkl
artifacts/preprocessor.joblib

# Environment variables and secrets
.env
.env.*
.streamlit/secrets.toml

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE and OS artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Dataset licensing protection: exclude proprietary / external raw data
data/raw/*
!data/raw/synthetic_phones_raw.csv
!data/raw/README.md
